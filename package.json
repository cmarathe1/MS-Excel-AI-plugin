{
  "name": "excel-ai-plugin",
  "private": true,
  "version": "0.1.0",
  "description": "Open-source, bring-your-own-model AI plugin for Microsoft Excel",
  "license": "MIT",
  "engines": {
    "node": ">=22.13.0"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "build": "pnpm -r --workspace-concurrency=1 build",
    "check": "pnpm --filter @excelai/shared build && pnpm -r check",
    "test": "pnpm --filter @excelai/shared build && pnpm -r test",
    "smoke": "pnpm build && pnpm --filter @excelai/sidecar smoke",
    "dev:sidecar": "pnpm --filter @excelai/sidecar dev"
  }
}
